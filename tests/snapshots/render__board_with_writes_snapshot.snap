</section>
<section class="tasks" data-src="chores/week.md"><h2><a href="/chores/week">Week chores</a></h2>
<ul><li data-task="todo" data-box="a0f29d06"><input type="checkbox"> Water the fern</li><li data-task="doing" data-box="20476c0b"><input type="checkbox"> Repot the basil <a class="tag" href="/.tachylite/tags/shed">#shed</a></li><li data-task="doing" data-box="c0aa9017"><input type="checkbox"> Tidy the shed</li><li data-task="todo" data-box="775533ce"><input type="checkbox"> Hang the rake</li><li data-task="doing" data-box="529dbd02"><input type="checkbox"> Mend the hose</li></ul>
<p class="meta"><a href="/chores/week">3 more</a> · 3 done · 2 cancelled</p>
</section>
<section class="tasks" data-src="welcome.md"><h2><a href="/welcome">Welcome</a></h2>
