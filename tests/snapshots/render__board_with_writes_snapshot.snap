</head>
<body>
<header><a href="/">Home</a><a href="/.tachylite/recent">Recent</a><a href="/.tachylite/tasks" aria-current="page">Tasks</a><button type="button" class="find" title="Find a note (Ctrl-K)">Find</button></header>
<main>
<h1 class="sr">Tasks</h1>
<section class="tasks" data-src="chores/errands.md"><h2><a href="/chores/errands">errands</a></h2>
